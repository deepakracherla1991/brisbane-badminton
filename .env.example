# Copy to .env.local and fill in. Never commit .env.local.

# --- Academy portal (Supabase) ---
# Supabase project > Project Settings > API (or "Connect"): Project URL and publishable key.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Show "Continue with Google" on sign-in/sign-up. Only set to true after enabling Google in Supabase (see README).
NEXT_PUBLIC_AUTH_GOOGLE=false
# Public site address, used in email links. Leave empty locally; set to e.g. https://www.badmintonbrisbane.com.au in production.
NEXT_PUBLIC_SITE_URL=

# Supabase SECRET key (Project Settings > API Keys > Secret keys). Server-only: never share it or
# prefix it with NEXT_PUBLIC_. Needed to record Square card payments.
SUPABASE_SECRET_KEY=

# --- Square card payments (https://developer.squareup.com/apps) ---
# The "Pay by card" option appears once these are set. Use sandbox credentials to test first.
SQUARE_ENVIRONMENT=sandbox
SQUARE_ACCESS_TOKEN=
SQUARE_LOCATION_ID=
# Webhook (recommended): subscribe to payment.created + payment.updated with this URL, then paste the signature key.
SQUARE_WEBHOOK_URL=https://www.badmintonbrisbane.com.au/api/square/webhook
SQUARE_WEBHOOK_SIGNATURE_KEY=

# --- Enrolment emails (Resend, https://resend.com) ---
# Without these, emails are printed to the server log instead of being sent.
RESEND_API_KEY=
# Sender address on a domain you've verified in Resend.
EMAIL_FROM="Brisbane Badminton <academy@badmintonbrisbane.com.au>"
EMAIL_REPLY_TO=admin@badmintonbrisbane.com.au

# --- "Birdie" chat assistant (https://console.anthropic.com) ---
# Without it, the chat still works using simple built-in answers from src/content/site.ts.
ANTHROPIC_API_KEY=
